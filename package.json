{
  "name": "opencode-team-mode",
  "version": "1.0.0",
  "description": "Team collaboration mode plugin for OpenCode Desktop — injects specialized agents (architect, reviewer, implementer, tester, researcher) and team workflow commands into your OpenCode workspace.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "tsc",
    "dev": "tsc --watch"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "team-mode",
    "collaboration",
    "multi-agent",
    "desktop",
    "ai-coding"
  ],
  "author": "",
  "license": "Apache-2.0",
  "peerDependencies": {
    "@opencode-ai/plugin": ">=0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/user/Opencode-TeamMode.git"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
